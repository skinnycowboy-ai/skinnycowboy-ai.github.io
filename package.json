{
  "name": "skinnycowboy-ai.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9.6.5"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "start": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test:boundaries": "node scripts/content-boundaries.test.mjs",
    "validate:content": "npm run test:boundaries && node scripts/validate-content.mjs",
    "build": "npm run validate:content && npm run check && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/validate-build.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "test": "npm run build"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.7",
    "astro": "7.2.2",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}
